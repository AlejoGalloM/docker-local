SET AUTHREC +
   PROFILE('**') +
   PRINCIPAL('app') +
   OBJTYPE(QUEUE) +
   AUTHADD(BROWSE,GET,INQ,PUT,PASSALL,PASSID)

SET AUTHREC +
   PROFILE('SYSTEM.ADMIN.COMMAND.QUEUE') +
   PRINCIPAL('app') +
   OBJTYPE(QUEUE) +
   AUTHADD(PUT,CRT,INQ)

SET AUTHREC +
   PROFILE('SYSTEM.DEFAULT.MODEL.QUEUE') +
   PRINCIPAL('app') +
   OBJTYPE(QUEUE) +
   AUTHADD(CRT,DSP,GET)

SET AUTHREC +
   PROFILE('SYSTEM.DEFAULT.LOCAL.QUEUE') +
   PRINCIPAL('app') +
   OBJTYPE(QUEUE) +
   AUTHADD(CRT,DSP)

SET AUTHREC +
   PROFILE('self') +
   PRINCIPAL('app') +
   OBJTYPE(QMGR) +
   AUTHADD(CONNECT,DSP,INQ)

SET AUTHREC +
   PROFILE('self') +
   PRINCIPAL('app') +
   OBJTYPE(QMGR) +
   AUTHADD(NONE)

